APP_NAME="Stylish Events API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:3001
AUTH_TOKEN_SECRET=your_secret
AUTH_TOKEN_TTL_SECONDS=28800
JWT_SECRET=your_fallback_secret
BOOTSTRAP_ADMIN_KEY=your_bootstrap_key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_VERIFY_ON_START=false
SMTP_REJECT_UNAUTHORIZED=true
MAIL_MAILER=smtp
MAIL_HOST=${SMTP_HOST}
MAIL_PORT=${SMTP_PORT}
MAIL_USERNAME=${SMTP_USER}
MAIL_PASSWORD=${SMTP_PASS}
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=${SMTP_USER}
MAIL_FROM_NAME="Stylish Events"
CHECKOUT_RESERVATION_HOURS=24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password
# Standard Laravel drivers (Not using database to avoid migrations against existing DB in Phase A)
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
HASH_DRIVER=scrypt
